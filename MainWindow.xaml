<Window x:Class="StealthBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StealthBrowser" Width="1200" Height="800"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 标签页栏 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource TabStripBrush}" Padding="8,8,8,0">
            <DockPanel>
                <Button x:Name="BtnNewTab" DockPanel.Dock="Right" Style="{StaticResource NavButton}"
                        Content="＋" ToolTip="新标签页" FontSize="16" Margin="4,0,0,0"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 工具栏 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBrush}" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="BtnBack" Style="{StaticResource NavButton}" Content="←" ToolTip="后退"/>
                    <Button x:Name="BtnForward" Style="{StaticResource NavButton}" Content="→" ToolTip="前进"/>
                    <Button x:Name="BtnReload" Style="{StaticResource NavButton}" Content="↻" ToolTip="刷新"/>
                    <Button x:Name="BtnHome" Style="{StaticResource NavButton}" Content="⌂" ToolTip="主页"/>
                </StackPanel>
                <Button x:Name="BtnStealth" DockPanel.Dock="Right" Style="{StaticResource PillButton}"
                        ToolTip="开关防截屏隐身" Margin="8,0,0,0"/>
                <Border CornerRadius="14" Background="{StaticResource AddressBgBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Margin="8,0" Padding="14,0" Height="32" VerticalAlignment="Center">
                    <TextBox x:Name="AddressBar" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                             VerticalAlignment="Center" FontSize="13"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource TabStripBrush}" Padding="10,5">
            <TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
        </Border>

        <!-- 页面内容 -->
        <ContentControl x:Name="TabContent" Background="{StaticResource BgBrush}"/>
    </DockPanel>
</Window>
